{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/HyperGaming99/bettermob/schemas/item.schema.json",
  "title": "BetterMob item file",
  "description": "One key per item id.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "Id"
    ],
    "properties": {
      "Id": {
        "type": "string",
        "description": "Base material, for example PAPER."
      },
      "Model": {
        "type": "integer",
        "description": "Custom model data."
      },
      "Display": {
        "type": "string",
        "description": "Name, & colour codes."
      },
      "Lore": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Lore lines."
      },
      "Skills": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "~[oO][nN][A-Za-z]+(:[0-9]+|(<=|>=|<|>)[0-9.]+%?)?(\\s+\\?!?[A-Za-z0-9_]+(\\{.*\\})?)?\\s*$",
          "description": "A skill line ending with a trigger, for example: sound{s=entity.pig.hurt} @self ~onDamaged"
        },
        "description": "Skill lines with a trigger, for example ~onUse."
      }
    }
  }
}
